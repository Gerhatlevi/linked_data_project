#################################################################

###  http://sw-portal.deri.org/ontologies/swportal#agent_1
swportal:agent_1 rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ,
                          owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain mydata:GlobalTopList ;
                 rdfs:range mydata:Content .


