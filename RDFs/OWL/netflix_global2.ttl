#################################################################
#    Data properties
#################################################################

###  http://schema.org/Date
schema1:Date rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain mydata:GlobalTopList ;
             rdfs:range xsd:date .


###  http://schema.org/category
schema1:category rdf:type owl:DatatypeProperty ;
                 rdfs:domain mydata:GlobalTopList ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:oneOf [ rdf:type rdf:List ;
                                          rdf:first "Films" ;
                                          rdf:rest [ rdf:type rdf:List ;
                                                     rdf:first "TV" ;
                                                     rdf:rest rdf:nil
                                                   ]
                                        ]
                            ] .


###  http://schema.org/inLanguage
schema1:inLanguage rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain mydata:GlobalTopList ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:oneOf [ rdf:type rdf:List ;
                                            rdf:first "English" ;
                                            rdf:rest [ rdf:type rdf:List ;
                                                       rdf:first "Non-English" ;
                                                       rdf:rest rdf:nil
                                                     ]
                                          ]
                              ] .


#################################################################
#    Classes
#################################################################

###  http://mydata.utwente.org/movies/Content
mydata:Content rdf:type owl:Class .


###  http://mydata.utwente.org/movies/GlobalTopList
mydata:GlobalTopList rdf:type owl:Class .


###  http://mydata.utwente.org/movies/Movie
mydata:Movie rdf:type owl:Class ;
             rdfs:subClassOf mydata:Content .


###  http://mydata.utwente.org/movies/TV
mydata:TV rdf:type owl:Class ;
          rdfs:subClassOf mydata:Content .
