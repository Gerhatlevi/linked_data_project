@prefix : <http://mydata.utwente.org/movies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mydata: <http://mydata.utwente.org/movies/> .
@prefix schema1: <http://schema.org/> .
@base <http://mydata.utwente.org/movies/> .

<http://mydata.utwente.org/movies/> rdf:type owl:Ontology .

#################################################################
#    Data properties
#################################################################

###  http://schema.org/ratingCount
schema1:ratingCount rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain mydata:Content ;
                    rdfs:range xsd:positiveInteger .


###  http://schema.org/ratingValue
schema1:ratingValue rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain mydata:Content ;
                    rdfs:range [ rdf:type rdfs:Datatype ;
                                 owl:onDatatype xsd:float ;
                                 owl:withRestrictions ( [ xsd:minInclusive "1.0"^^xsd:float
                                                        ]
                                                        [ xsd:maxInclusive "10.0"^^xsd:float
                                                        ]
                                                      )
                               ] .


#################################################################
#    Classes
#################################################################

###  http://mydata.utwente.org/movies/Content
mydata:Content rdf:type owl:Class .


